{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-dot-agents.github.io/Open-Dot-Agents/spec/v1/schema/adapter-publisher.schema.json",
  "title": "Dota adapter publisher manifest",
  "type": "object",
  "required": ["id", "name", "version", "protocolVersion", "capabilities", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "id": { "$ref": "common.schema.json#/$defs/reverseDnsId" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "protocolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["validate", "import", "export"] } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/artifact" } }
  }
}
