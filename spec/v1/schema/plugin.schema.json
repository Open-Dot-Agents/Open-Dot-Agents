{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-dot-agents.github.io/Open-Dot-Agents/spec/v1/schema/plugin.schema.json",
  "type": "object",
  "required": ["id", "version", "description", "contents"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/reverseDnsId" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "contents": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/relativePath" } },
    "dependencies": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/reverseDnsId" } }
  }
}
