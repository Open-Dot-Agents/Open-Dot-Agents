{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-dot-agents.github.io/Open-Dot-Agents/spec/v1/schema/hooks.schema.json",
  "type": "object",
  "required": ["hooks"],
  "additionalProperties": false,
  "properties": {
    "hooks": { "type": "array", "items": { "$ref": "#/$defs/hook" } }
  },
  "$defs": {
    "hook": {
      "type": "object",
      "required": ["id", "event", "action"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "event": { "enum": ["session-start", "session-end", "before-tool", "after-tool", "before-compaction", "before-handoff"] },
        "priority": { "type": "integer", "default": 0 },
        "matcher": { "type": "object" },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "onFailure": { "enum": ["continue", "warn", "block"] },
        "action": {
          "oneOf": [
            { "type": "object", "required": ["type", "command"], "additionalProperties": false, "properties": { "type": { "const": "command" }, "command": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
            { "type": "object", "required": ["type", "url"], "additionalProperties": false, "properties": { "type": { "const": "http" }, "url": { "type": "string", "format": "uri" } } },
            { "type": "object", "required": ["type", "prompt"], "additionalProperties": false, "properties": { "type": { "const": "prompt" }, "prompt": { "type": "string", "minLength": 1 } } },
            { "type": "object", "required": ["type", "agent"], "additionalProperties": false, "properties": { "type": { "const": "agent" }, "agent": { "type": "string", "minLength": 1 } } }
          ]
        }
      }
    }
  }
}
