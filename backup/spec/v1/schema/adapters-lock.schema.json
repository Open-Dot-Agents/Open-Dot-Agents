{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-dot-agents.github.io/Open-Dot-Agents/spec/v1/schema/adapters-lock.schema.json",
  "title": "Dota adapter lock",
  "type": "object",
  "required": ["lockVersion", "adapters"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "lockVersion": { "const": 1 },
    "adapters": { "type": "array", "items": { "$ref": "#/$defs/adapter" } }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "required": ["id", "version", "protocolVersion", "source", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/reverseDnsId"},
        "version": { "type": "string", "minLength": 1 },
        "protocolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "source": {
          "oneOf": [
            { "type": "object", "required": ["type", "path", "sha256"], "additionalProperties": false, "properties": { "type": { "const": "path" }, "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
            { "type": "object", "required": ["type", "manifest", "artifacts"], "additionalProperties": false, "properties": { "type": { "const": "release" }, "manifest": { "type": "string", "format": "uri" }, "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/artifact"} } } }
          ]
        },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["validate", "import", "export"] } }
      }
    }
  }
}
