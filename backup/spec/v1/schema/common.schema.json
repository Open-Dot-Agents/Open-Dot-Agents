{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-dot-agents.github.io/Open-Dot-Agents/spec/v1/schema/common.schema.json",
  "title": "Open-Dot-Agents common definitions",
  "$defs": {
    "reverseDnsId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$" },
    "relativePath": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^DOTA[0-9]{4}$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["os", "arch", "url", "sha256"],
      "additionalProperties": false,
      "properties": {
        "os": { "enum": ["linux", "darwin", "windows"] },
        "arch": { "enum": ["amd64", "arm64"] },
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sigstoreBundle": { "type": "string" }
      }
    }
  }
}
