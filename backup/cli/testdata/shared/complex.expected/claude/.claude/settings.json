{
  "hooks": {
    "PostToolUse": [],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/audit.sh"
          }
        ]
      }
    ],
    "SessionEnd": [],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo ready"
          }
        ]
      }
    ]
  }
}
