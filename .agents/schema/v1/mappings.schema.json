{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-dot-agents.local/schema/v1/mappings.schema.json",
  "title": "Open-Dot-Agents mappings contract v1",
  "description": "Machine-readable mapping metadata for category support across target adapters.",
  "type": "object",
  "required": [".agents"],
  "additionalProperties": false,
  "properties": {
    ".agents": {
      "$ref": "#/$defs/mappings_block"
    }
  },
  "$defs": {
    "mappings_block": {
      "type": "object",
      "required": ["manifest", "targets", "status"],
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "memories": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "manifest": {
          "$ref": "#/$defs/manifest"
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/target"
          },
          "minProperties": 1
        },
        "status": {
          "$ref": "#/$defs/status_matrix"
        },
        "status_notes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/status_target_notes"
          },
          "description": "Optional per-target support notes when a category is partial or has caveats."
        },
        "compatibility_notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional mapping-level notes."
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": ["format_version", "canonical_root"],
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 1
        },
        "canonical_root": {
          "type": "string",
          "const": ".agents"
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["id", "name", "docs"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        },
        "doc": {
          "type": "string",
          "format": "uri",
          "description": "Optional shorthand when there is a single canonical doc link."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "status_matrix": {
      "type": "object",
      "required": [
        "agents",
        "guardrails",
        "hooks",
        "instructions",
        "memories",
        "permissions",
        "plugins",
        "profiles",
        "prompts",
        "rules",
        "settings",
        "skills",
        "tools"
      ],
      "additionalProperties": false,
      "properties": {
        "agents": { "$ref": "#/$defs/category_status_by_target" },
        "guardrails": { "$ref": "#/$defs/category_status_by_target" },
        "hooks": { "$ref": "#/$defs/category_status_by_target" },
        "instructions": { "$ref": "#/$defs/category_status_by_target" },
        "memories": { "$ref": "#/$defs/category_status_by_target" },
        "permissions": { "$ref": "#/$defs/category_status_by_target" },
        "plugins": { "$ref": "#/$defs/category_status_by_target" },
        "profiles": { "$ref": "#/$defs/category_status_by_target" },
        "prompts": { "$ref": "#/$defs/category_status_by_target" },
        "rules": { "$ref": "#/$defs/category_status_by_target" },
        "settings": { "$ref": "#/$defs/category_status_by_target" },
        "skills": { "$ref": "#/$defs/category_status_by_target" },
        "tools": { "$ref": "#/$defs/category_status_by_target" }
      }
    },
    "category_status_by_target": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/category_status"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9-]+$"
      },
      "description": "Map of target id to status."
    },
    "category_status": {
      "type": "string",
      "enum": ["supported", "unsupported", "mapped", "partial"]
    },
    "status_target_notes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Optional free-text notes keyed by target id."
    }
  }
}
