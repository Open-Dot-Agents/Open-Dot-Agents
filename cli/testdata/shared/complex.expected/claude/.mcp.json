{
  "mcpServers": {
    "local-docs": {
      "type": "stdio",
      "command": "node",
      "args": ["tools/docs-server.js", "--project"],
      "env": {
        "LOG_LEVEL": "debug",
        "PROJECT_MODE": "read-only"
      }
    },
    "remote-issues": {
      "type": "http",
      "url": "https://issues.example.test/mcp",
      "headers": {
        "Authorization": "Bearer ${ISSUES_TOKEN}",
        "X-Project": "open-dot-agents"
      }
    }
  }
}
